# E2E test environment — loaded by playwright.config.ts via dotenv.
# Override .env asli agar build/start tidak memakai credentials production.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/portfolio_test
BETTER_AUTH_SECRET=ci-e2e-test-secret-1234567890abcdef
BETTER_AUTH_URL=http://localhost:3005
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3005
DISABLE_RATE_LIMIT=true

# Turnstile keys dikosongkan agar widget tidak render & verifikasi di-skip di E2E.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Supabase (placeholder for build — not used in E2E tests)
NEXT_PUBLIC_SUPABASE_URL=https://placeholder.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=placeholder-anon-key
SUPABASE_SERVICE_ROLE_KEY=placeholder-service-key
