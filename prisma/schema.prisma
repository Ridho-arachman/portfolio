// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// =============================================================================
// 1. BETTER AUTH TABLES (Standard Schema)
// =============================================================================

model User {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  role          Role     @default(USER)

  sessions      Session[]
  accounts      Account[]
  verifications Verification[]

  @@map("user")
}

model Session {
  id        String   @id
  userId    String
  token     String   @unique
  expiresAt DateTime
  userAgent String?
  ipAddress String?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User?    @relation(fields: [userId], references: [id])
  userId     String?

  @@index([identifier])
  @@map("verification")
}

// =============================================================================
// 2. PORTFOLIO CORE TABLES (Projects & Categories)
// =============================================================================

model Category {
  id          String   @id @default(cuid())
  name        String   @unique // e.g., "Web Development", "Mobile App"
  slug        String   @unique // e.g., "web-dev"
  description String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  projects Project[]

  @@index([slug])
}

model Project {
  id           String    @id @default(cuid())
  title        String
  slug         String    @unique // Untuk URL friendly: /projects/nextjs-portfolio
  description  String    @db.Text
  thumbnail    String // URL gambar cover
  liveUrl      String? // Link demo (opsional)
  repoUrl      String? // Link GitHub (opsional)
  technologies String[] // Array of strings: ["Next.js", "Tailwind", "Prisma"]
  isPublished  Boolean   @default(true)
  order        Int       @default(0) // Untuk sorting manual di admin
  categoryId   String?
  category     Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([slug])
  @@index([isPublished])
  @@index([categoryId])
  @@index([order])
}

// =============================================================================
// 3. PORTFOLIO SUPPORT TABLES (Messages, Skills, Experience)
// =============================================================================

model Message {
  id        String        @id @default(cuid())
  name      String
  email     String
  subject   String
  content   String        @db.Text
  status    MessageStatus @default(NEW)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([status])
  @@index([createdAt(sort: Desc)])
}

model Skill {
  id          String        @id @default(cuid())
  name        String        @unique // e.g., "React", "PostgreSQL"
  iconUrl     String? // URL icon (bisa dari Simple Icons atau local)
  category    SkillCategory
  proficiency Int // 1-100 (untuk animasi progress bar di UI)
  order       Int           @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([category])
  @@index([order])
}

model Experience {
  id          String         @id @default(cuid())
  title       String // e.g., "Frontend Developer Intern", "Ketua Himpunan"
  company     String // e.g., "PT Tech Startup", "Himpunan Mahasiswa SI"
  logoUrl     String? // URL logo perusahaan/organisasi (opsional)
  type        ExperienceType // Kategori pengalaman
  location    String // e.g., "Jakarta, Indonesia" atau "Remote"
  startDate   DateTime // Tanggal mulai
  endDate     DateTime? // Tanggal selesai (Nullable = Masih berlangsung / "Present")
  isCurrent   Boolean        @default(false) // Flag helper untuk UI badge "Present"
  description String[] // Array of strings untuk bullet points pencapaian
  order       Int            @default(0) // Untuk sorting manual di Admin Dashboard
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([type])
  @@index([order])
}

// =============================================================================
// 4. ENUMS
// =============================================================================

enum Role {
  USER
  ADMIN
}

enum MessageStatus {
  NEW
  READ
  REPLIED
  ARCHIVED
}

enum SkillCategory {
  FRONTEND
  BACKEND
  DATABASE
  DEVOPS_TOOLS
  SOFT_SKILL
}

enum ExperienceType {
  WORK // Pekerjaan / Magang
  ORGANIZATION // Organisasi Kampus / Himpunan / BEM
  FREELANCE // Proyek Lepas
  EDUCATION // Pendidikan Formal / Bootcamp / Kursus
  CERTIFICATION // Sertifikasi Profesional
}
