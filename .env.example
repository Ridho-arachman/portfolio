# =============================================================================
# ENVIRONMENT VARIABLES — salin file ini menjadi `.env` lalu isi nilai asli.
# JANGAN commit file `.env` ke repository.
# =============================================================================

## Database (Supabase PostgreSQL)
# Lokal/dev: direct connection (port 5432)
DATABASE_URL="postgresql://postgres:PASSWORD@db.XXXX.supabase.co:5432/postgres?sslmode=require"
# Produksi Vercel: gunakan SUPABASE POOLER (mode Transaction, port 6543)
# DATABASE_URL="postgresql://postgres:PASSWORD@db.XXXX.pooler.supabase.co:6543/postgres?pgbouncer=true&connection_limit=5&sslmode=require"

## Auth — better-auth
# Generate: openssl rand -base64 32
BETTER_AUTH_SECRET=""
# URL aplikasi (localhost untuk dev, domain vercel untuk prod)
BETTER_AUTH_URL="http://localhost:3000"
# Wajib sama dengan BETTER_AUTH_URL (dibaca client-side)
NEXT_PUBLIC_BETTER_AUTH_URL="http://localhost:3000"

## Cloudflare Turnstile (CAPTCHA)
# Dapat di: dash.cloudflare.com -> Turnstile -> Add Site
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""
# Test keys resmi (untuk CI/E2E, otomatis lolos):
#   NEXT_PUBLIC_TURNSTILE_SITE_KEY="1x00000000000000000000AA"
#   TURNSTILE_SECRET_KEY="1x0000000000000000000000000000000AA"

## Social Login — Google OAuth
# Dapat di: console.cloud.google.com -> APIs & Services -> Credentials -> OAuth Client ID (Web application)
# Redirect URI: {BETTER_AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

## Social Login — GitHub OAuth
# Dapat di: github.com -> Settings -> Developer settings -> OAuth Apps -> New OAuth App
# Callback URL: {BETTER_AUTH_URL}/api/auth/callback/github
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

## Seed Admin (npm run db:seed)
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

## Opsional — Rate limit (nilai bawaan dipakai jika dikosongkan)
# AUTH_RATE_LIMIT_SIGNIN_MAX=5
# AUTH_RATE_LIMIT_SIGNUP_MAX=5
# Set ke "true" untuk menonaktifkan rate limiting (hanya untuk tes/dev)
# DISABLE_RATE_LIMIT=false
